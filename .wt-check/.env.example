# Copier en .env.local (ignoré par git) et renseigner les valeurs du projet
# Supabase partagé avec le mobile (Settings › API). Mêmes valeurs que les
# EXPO_PUBLIC_SUPABASE_* du mobile : seul le préfixe change (Vite n'expose
# au frontend que les variables VITE_*).
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
